# Automatically generated configuration
# ImmortalWrt SL-3000 eMMC MT7981B | 精简版 | MTWiFi+HNAT | Github Actions
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y

# -------------------------- Target 平台 --------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000_emmc=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_CPU_TYPE="cortex-a53"

# -------------------------- 内核基础设置（6.6分支） --------------------------
CONFIG_LINUX_6_6=y
CONFIG_KERNEL_DEBUG=n
CONFIG_KERNEL_SELINUX=n
CONFIG_KERNEL_CGROUP=n
CONFIG_KERNEL_PROFILING=n

# -------------------------- 文件系统 eMMC + squashfs --------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS_4K=y
CONFIG_TARGET_ROOTFS_PERSISTENT=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_e2fsprogs=y

# -------------------------- 基础系统必备包 --------------------------
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mountd=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dropbear=y

# -------------------------- MT7981 MTWiFi WiFi6 + MTK HNAT硬件加速【核心】 --------------------------
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mtwifi=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_mtk-hnat=y
CONFIG_PACKAGE_mtk-eth=y

# -------------------------- LuCI最简中文后台 --------------------------
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_cgi-io=y

# -------------------------- 关闭所有非必需组件（精简，Github编译提速） --------------------------
# Docker
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
# QoS/SQM
CONFIG_PACKAGE_sqm-scripts=n
# USB 全部关闭
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-storage=n
# 代理/VPN
CONFIG_PACKAGE_v2raya=n
CONFIG_PACKAGE_wireguard-tools=n
# 文件共享
CONFIG_PACKAGE_samba4-server=n
# 网页终端
CONFIG_PACKAGE_ttyd=n
# 监控统计
CONFIG_PACKAGE_luci-app-statistics=n
# DDNS
CONFIG_PACKAGE_ddns-scripts=n
# 其他
CONFIG_PACKAGE_zerotier=n
CONFIG_PACKAGE_avahi-daemon=n
CONFIG_PACKAGE_autocore=n
CONFIG_PACKAGE_autocore-arm=n
CONFIG_PACKAGE_zigbee2mqtt=n

# -------------------------- 镜像输出选项 --------------------------
CONFIG_BUILD_SYSUPGRADE=y
CONFIG_BUILD_INITRAMFS=n
CONFIG_INCLUDE_CONFIG=y
CONFIG_SIGNED_PACKAGES=n
CONFIG_SIGNATURE_CHECK=n
CONFIG_IMAGEOPT=y
